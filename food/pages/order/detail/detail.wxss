page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #f8f8f8;
}

.top {
  padding: 20rpx;
}

.card {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
  border-radius: 16rpx;
  padding: 30rpx;
}

.card-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 15rpx;
}

.card-content {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 12rpx;
  padding: 25rpx;
}

.card-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.card-code {
  font-size: 56rpx;
  font-weight: bold;
  color: #ff6b6b;
  font-family: monospace;
}

.card-info-r {
  font-size: 26rpx;
  color: #999;
}

.card-comment {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 0;
  border-bottom: 1rpx dashed #e3e3e3;
  margin-bottom: 10rpx;
}

.card-tips {
  font-size: 26rpx;
  color: #ff9c35;
  text-align: center;
  padding-top: 10rpx;
}

.order {
  background: white;
  margin-top: 20rpx;
}

.order-title {
  font-size: 24rpx;
  color: #a2a1a0;
  padding: 24rpx;
}

.order-list {
  padding: 0 30rpx;
}

.order-item {
  background: #fff;
  display: flex;
  font-size: 32rpx;
  padding: 25rpx 0;
  border-top: 1rpx #e3e3e3 solid;
}

.order-item-left {
  flex: 1;
  display: flex;
}

.order-item-image {
  width: 94rpx;
  height: 94rpx;
  margin-right: 25rpx;
}

.order-item-name {
  font-size: 32rpx;
  color: #333;
}

.order-item-number {
  color: #a3a3a3;
  margin-top: 4rpx;
  font-size: 28rpx;
}

.order-item-price {
  font-size: 32rpx;
  color: #333;
}

.order-promotion-icon {
  display: inline-block;
  background: #ff4500;
  padding: 2rpx 6rpx 6rpx;
  color: #fff;
  font-size: 28rpx;
  margin-right: 8rpx;
}

.order-promotion-price {
  color: #ff4500;
}

.order-total-price {
  font-size: 40rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.list {
  background: #fff;
  margin-top: 20rpx;
}

.list > view {
  font-size: 30rpx;
  color: #d1d1d1;
  padding: 20rpx;
  border-bottom: 1rpx #e3e3e3 solid;
  display: flex;
}

.list > view > view {
  color: black;
  margin-left: 20rpx;
}

.tips {
  width: 80%;
  text-align: center;
  margin: 20rpx auto 20rpx;
  padding: 12rpx 20rpx;
  background: #ff9c35;
  color: #fff;
  font-size: 36rpx;
}

.comment-btn {
  width: 80%;
  margin: 0 auto 40rpx;
  text-align: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
  color: #fff;
  font-size: 32rpx;
  border-radius: 40rpx;
}